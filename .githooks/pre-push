#!/bin/sh
# Refuses a push to the default branch, which advances only through a merged
# pull request, and runs the full check before any other branch is pushed.
#   pre-push <remote> <url>, with "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin
set -eu
cd "$(git rev-parse --show-toplevel)"

default=$(git symbolic-ref --quiet --short "refs/remotes/$1/HEAD" 2>/dev/null | sed "s|^$1/||")
default=${default:-main}
zero=0000000000000000000000000000000000000000

branches=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
	case $remote_ref in
	"refs/heads/$default")
		echo "pre-push: $default advances only through a merged pull request." >&2
		echo "  Push your branch and open one: scripts/agent pr" >&2
		exit 1
		;;
	refs/heads/*) [ "$local_sha" = "$zero" ] || branches=1 ;;
	esac
done

# Tag pushes and branch deletions build nothing new.
[ "$branches" -eq 0 ] || scripts/task check
